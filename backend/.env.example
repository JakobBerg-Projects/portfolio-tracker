# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# PostgreSQL connection string (local database or a Supabase project).
# For Supabase: dashboard → Connect → Session pooler, then change the
# scheme from postgresql:// to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stock_portfolio

# Anthropic API key for the AI advisor tab — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Secret used to sign JWT auth tokens. Use a long, random value.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
